<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lock_gradient"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/lockIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/app_icon_desc"
            android:src="@drawable/ic_lock"
            app:tint="?attr/colorPrimary" />

        <com.example.applocker.PinKeypadView
            android:id="@+id/keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/fingerprintArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/fingerprintIcon"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/biometric_title"
                android:padding="4dp"
                android:src="@drawable/ic_fingerprint"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/fingerprintHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/biometric_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
