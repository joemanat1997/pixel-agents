<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppLocker" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
    </style>

    <!-- Lock screen: full-screen, no action bar -->
    <style name="Theme.AppLocker.Lock" parent="Theme.AppLocker">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/lock_background</item>
    </style>
</resources>
