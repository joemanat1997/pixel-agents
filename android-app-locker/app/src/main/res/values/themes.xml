<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppLocker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    </style>

    <!-- Accent themes -->
    <style name="Theme.AppLocker.Teal" parent="Theme.AppLocker" />

    <style name="Theme.AppLocker.Orange" parent="Theme.AppLocker">
        <item name="colorPrimary">#FF7A1A</item>
        <item name="colorOnPrimary">#1A0E00</item>
        <item name="colorSecondary">#FF7A1A</item>
    </style>

    <style name="Theme.AppLocker.Blue" parent="Theme.AppLocker">
        <item name="colorPrimary">#4F8CFF</item>
        <item name="colorOnPrimary">#06183A</item>
        <item name="colorSecondary">#4F8CFF</item>
    </style>

    <style name="Theme.AppLocker.Violet" parent="Theme.AppLocker">
        <item name="colorPrimary">#A78BFA</item>
        <item name="colorOnPrimary">#1E1633</item>
        <item name="colorSecondary">#A78BFA</item>
    </style>

    <style name="Theme.AppLocker.Rose" parent="Theme.AppLocker">
        <item name="colorPrimary">#FB7185</item>
        <item name="colorOnPrimary">#3A0A14</item>
        <item name="colorSecondary">#FB7185</item>
    </style>

    <style name="Theme.AppLocker.Green" parent="Theme.AppLocker">
        <item name="colorPrimary">#34C759</item>
        <item name="colorOnPrimary">#06310F</item>
        <item name="colorSecondary">#34C759</item>
    </style>

    <style name="Theme.AppLocker.Red" parent="Theme.AppLocker">
        <item name="colorPrimary">#F25555</item>
        <item name="colorOnPrimary">#3A0A0A</item>
        <item name="colorSecondary">#F25555</item>
    </style>

    <style name="Theme.AppLocker.Amber" parent="Theme.AppLocker">
        <item name="colorPrimary">#F5A623</item>
        <item name="colorOnPrimary">#2A1A00</item>
        <item name="colorSecondary">#F5A623</item>
    </style>

    <style name="Theme.AppLocker.Cyan" parent="Theme.AppLocker">
        <item name="colorPrimary">#22C8E0</item>
        <item name="colorOnPrimary">#062A30</item>
        <item name="colorSecondary">#22C8E0</item>
    </style>

    <style name="Theme.AppLocker.Indigo" parent="Theme.AppLocker">
        <item name="colorPrimary">#6C72F0</item>
        <item name="colorOnPrimary">#0E1040</item>
        <item name="colorSecondary">#6C72F0</item>
    </style>

    <style name="Theme.AppLocker.Pink" parent="Theme.AppLocker">
        <item name="colorPrimary">#EC4899</item>
        <item name="colorOnPrimary">#3A0A22</item>
        <item name="colorSecondary">#EC4899</item>
    </style>

    <style name="Theme.AppLocker.Lime" parent="Theme.AppLocker">
        <item name="colorPrimary">#9CCC65</item>
        <item name="colorOnPrimary">#18260A</item>
        <item name="colorSecondary">#9CCC65</item>
    </style>

    <!-- Lock screen: full-screen, gradient window background -->
    <style name="Theme.AppLocker.Lock" parent="Theme.AppLocker">
        <item name="android:windowBackground">@drawable/bg_lock_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
